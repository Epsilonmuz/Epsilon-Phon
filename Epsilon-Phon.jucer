<?xml version="1.0" encoding="UTF-8"?>

<JUCERPROJECT id="EPhn01" name="Epsilon Phon" projectType="audioplug" version="1.1.0"
              companyName="Epsilon Sounds" bundleIdentifier="com.epsilonsounds.phon"
