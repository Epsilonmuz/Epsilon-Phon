              pluginCode="EpPh" pluginFormats="buildVST3,buildAU,buildStandalone"
              pluginCharacteristicsValue=""
              pluginVST3Category="Fx|Analyzer|EQ" pluginAUMainType="'aufx'"
              cppLanguageStandard="17" useAppConfig="0" addUsingNamespaceToJuceHeader="0"
